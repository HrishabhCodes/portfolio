---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import WritingCard from "../../components/WritingCard.astro";
import ViewSwitch from "../../components/ViewSwitch.astro";
import WritingFilters from "../../components/WritingFilters.astro";
import YearGroup from "../../components/YearGroup.astro";
import { getPosts } from "../../lib/writing-data";
import { groupByYear } from "../../lib/writing-group";
import { buildWritingJsonLd } from "../../lib/schema";

const posts = await getPosts();
const pageUrl = new URL("/writing", Astro.site).href;

---

<Base
  title="Writing · Hrishabh Jain | Notes on AI Agents, RAG & GEO"
  description="Articles and posts by Hrishabh Jain on AI agents, RAG, generative engine optimization (GEO) and shipping AI to production, from Medium, LinkedIn and X."
  ogType="website"
  graph={buildWritingJsonLd(posts, pageUrl)}
>
  <Nav />
  <main class="wrap page">
    <header class="intro">
      <p class="eyebrow">
        <span class="dash" aria-hidden="true"></span>
        <span class="label">{posts.length} pieces</span>
      </p>
      <h1>Writing<span class="dot">.</span></h1>
      <p class="lede">
        Notes on AI agents, RAG, GEO and building things that hold up in production. Long reads on Medium,
        quick takes on LinkedIn and X.
      </p>
      <ViewSwitch current="cards" />

      <WritingFilters posts={posts} />
    </header>

    {groupByYear(posts).map(([year, list]) => (
      <YearGroup year={year} count={list.length}>
        {list.map((post) => <WritingCard post={post} />)}
      </YearGroup>
    ))}
  </main>
  <Footer num="" />
</Base>

<style>
  .page { padding-top: clamp(48px, 8vw, 96px); }
  .eyebrow { display: flex; align-items: center; gap: 12px; }
  .num { font-family: var(--mono); font-size: 13px; color: var(--accent); }
  .dash { width: 32px; height: 2px; background: var(--accent); }
  .eyebrow .label { color: var(--fg-2); }
  h1 {
    margin-top: 16px;
    font-size: clamp(56px, 10vw, 136px);
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: -0.055em;
  }
  .dot { color: var(--accent); }
  .lede { margin-top: 24px; max-width: 34em; font-size: clamp(16px, 1.6vw, 20px); line-height: 1.45; color: var(--fg-2); }

</style>
