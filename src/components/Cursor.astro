<div class="cursor-ring" aria-hidden="true"></div>
<div class="cursor-dot" aria-hidden="true"></div>

<script>
  const fine = matchMedia("(pointer: fine)").matches;
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const ring = document.querySelector<HTMLElement>(".cursor-ring");
  const dot = document.querySelector<HTMLElement>(".cursor-dot");

  if (fine && !calm && ring && dot) {
    const root = document.documentElement;
    const INTERACTIVE = "a, button, summary, [data-count]";
    let x = -100, y = -100;   // pointer
    let rx = -100, ry = -100; // ring (eased)
    let raf = 0;

    const tick = () => {
      rx += (x - rx) * 0.18;
      ry += (y - ry) * 0.18;
      ring.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
      raf = Math.abs(x - rx) + Math.abs(y - ry) > 0.1 ? requestAnimationFrame(tick) : 0;
    };

    // Embeds (X, LinkedIn) are cross-origin iframes: once the pointer enters one, this page
    // gets no events at all, so the custom cursor would freeze on the edge. Hand over to the
    // native cursor whenever the pointer is near an iframe or about to land inside one.
    const HALO = 24;
    const hide = () => root.classList.remove("cursor-on", "cursor-hover", "cursor-down");
    const nearFrame = (px: number, py: number, dx: number, dy: number) => {
      for (const f of document.getElementsByTagName("iframe")) {
        const r = f.getBoundingClientRect();
        if (!r.width || !r.height) continue;
        for (const [qx, qy] of [[px, py], [px + dx * 2, py + dy * 2]]) {
          if (qx > r.left - HALO && qx < r.right + HALO && qy > r.top - HALO && qy < r.bottom + HALO) return true;
        }
      }
      return false;
    };

    addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      const dx = e.clientX - x, dy = e.clientY - y;
      x = e.clientX;
      y = e.clientY;
      if (nearFrame(x, y, dx, dy)) return hide();
      dot.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      if (!root.classList.contains("cursor-on")) {
        rx = x; ry = y;
        root.classList.add("cursor-on");
      }
      raf ||= requestAnimationFrame(tick);
    }, { passive: true });

    addEventListener("pointerover", (e) => {
      root.classList.toggle("cursor-hover", !!(e.target as Element).closest?.(INTERACTIVE));
    });
    addEventListener("pointerdown", () => root.classList.add("cursor-down"));
    addEventListener("pointerup", () => root.classList.remove("cursor-down"));
    addEventListener("pointerout", (e) => {
      if (!e.relatedTarget || e.relatedTarget instanceof HTMLIFrameElement) hide();
    });
    // Focus moving into an iframe (e.g. a click inside an embed) also means we lost the pointer.
    addEventListener("blur", hide);
  }
</script>

<style is:global>
  .cursor-ring, .cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    pointer-events: none;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .cursor-dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--accent);
  }
  .cursor-ring::before {
    content: "";
    position: absolute;
    left: -18px;
    top: -18px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--fg) 45%, transparent);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), background-color 0.3s ease, border-color 0.3s ease;
  }

  .cursor-on .cursor-ring, .cursor-on .cursor-dot { opacity: 1; }
  .cursor-on, .cursor-on * { cursor: none !important; }

  .cursor-hover .cursor-ring::before {
    transform: scale(1.6);
    border-color: var(--accent);
    background-color: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .cursor-hover .cursor-dot { opacity: 0; }
  .cursor-down .cursor-ring::before { transform: scale(0.75); }
  .cursor-hover.cursor-down .cursor-ring::before { transform: scale(1.3); }
</style>
