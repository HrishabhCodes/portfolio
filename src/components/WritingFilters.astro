---
import type { Post } from "../lib/writing";
import { PLATFORM_LABEL } from "../lib/writing-data";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const order: Post["platform"][] = ["medium", "linkedin", "x"];
// 24×24 glyphs: a grid for "All", brand marks (Simple Icons) for each platform.
const ICONS: Record<string, string> = {
  all: "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z",
  medium:
    "M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z",
  linkedin:
    "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  x: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
};
const filters = [
  { key: "all", label: "All", count: posts.length },
  ...order
    .map((k) => ({ key: k, label: k === "medium" ? "Articles" : PLATFORM_LABEL[k], count: posts.filter((p) => p.platform === k).length }))
    .filter((f) => f.count > 0),
];
---

{filters.length > 2 && (
  <div class="filters" role="group" aria-label="Filter by platform">
    {filters.map((f, i) => (
      <button type="button" data-filter={f.key} aria-pressed={i === 0 ? "true" : "false"}>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[f.key]} /></svg>
        {f.label} <span class="count">{f.count}</span>
      </button>
    ))}
  </div>
)}

<script>
  // Works on any page with [data-platform] items grouped in [data-year] sections.
  // The active filter lives in ?type= so it survives reloads and view switches.
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>("[data-year] [data-platform]");
  const years = document.querySelectorAll<HTMLElement>("[data-year]");
  const viewLinks = document.querySelectorAll<HTMLAnchorElement>("[data-view-link]");

  function apply(key: string) {
    const btn = [...buttons].find((b) => b.dataset.filter === key);
    if (!btn) return apply("all");
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    // On phones the row scrolls sideways; keep the active chip in view without moving the page.
    const row = btn.parentElement!;
    row.scrollLeft = Math.max(0, btn.offsetLeft - row.offsetLeft - (row.clientWidth - btn.offsetWidth) / 2);
    items.forEach((el) => (el.hidden = key !== "all" && el.dataset.platform !== key));
    years.forEach((y) => {
      const n = y.querySelectorAll("[data-platform]:not([hidden])").length;
      y.hidden = n === 0;
      const label = y.querySelector("[data-year-count]");
      if (label) label.textContent = `${n} ${n === 1 ? "piece" : "pieces"}`;
    });

    const url = new URL(location.href);
    if (key === "all") url.searchParams.delete("type");
    else url.searchParams.set("type", key);
    history.replaceState(null, "", url);
    viewLinks.forEach((a) => (a.search = url.search));
  }

  if (buttons.length) {
    buttons.forEach((b) => b.addEventListener("click", () => apply(b.dataset.filter!)));
    const initial = new URLSearchParams(location.search).get("type");
    if (initial) apply(initial);
  }
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  button {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 14px;
    padding: 7px 14px;
    border: 1px solid var(--line);
    color: var(--fg-2);
    white-space: nowrap;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  button:hover { border-color: var(--fg-2); color: var(--fg); }
  button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .icon { width: 14px; height: 14px; fill: currentColor; flex: none; }
  .count { font-family: var(--mono); font-size: 11px; font-weight: 400; opacity: 0.7; margin-left: -2px; }

  /* Phones: one swipeable row that bleeds to the screen edge instead of wrapping. */
  @media (max-width: 640px) {
    .filters {
      flex-wrap: nowrap;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
    }
    .filters::-webkit-scrollbar { display: none; }
    button { padding: 10px 14px; }
  }
</style>

<style is:global>
  [data-year][hidden], [data-year] [data-platform][hidden] { display: none !important; }
</style>
