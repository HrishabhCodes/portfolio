---
import { profile, socials } from "../data/profile";

interface Props {
  num?: string;
}

const { num = "09" } = Astro.props;
const year = new Date().getFullYear();
const updated = new Intl.DateTimeFormat("en", { day: "numeric", month: "short", year: "numeric" }).format(new Date());
---

<footer id="contact" class="footer wrap" aria-labelledby="contact-title">
  <p class="eyebrow">
    {num && <span class="num">{num}</span>}
    <span class="dash" aria-hidden="true"></span>
    <span class="label side">Contact</span>
  </p>

  <h2 id="contact-title" data-reveal>Let's build <br />something<span>.</span></h2>
  <p class="sub" data-reveal>
    Agents, RAG, a gnarly backend, or just want to talk models? My inbox is open.
  </p>

  <div class="actions" data-reveal>
    <a class="email" href={`mailto:${profile.email}`} data-copy-email={profile.email}>
      {profile.email}
      <span class="hint label" aria-hidden="true">click to copy</span>
    </a>
    <ul class="socials">
      {socials.map((s) => (
        <li><a class="link-u" href={s.href} target="_blank" rel="me noopener">{s.name} ↗</a></li>
      ))}
    </ul>
  </div>

  <div class="base label">
    <span>© {year} {profile.name} · {profile.location.city}, {profile.location.country}</span>
    <span>Last built {updated}</span>
  </div>

  <div class="toast label" role="status" aria-live="polite"></div>
</footer>

<script>
  const toast = document.querySelector<HTMLElement>(".toast");
  let timer: number | undefined;

  for (const el of document.querySelectorAll<HTMLAnchorElement>("[data-copy-email]")) {
    el.addEventListener("click", async (e) => {
      if (!navigator.clipboard || !toast) return; // let mailto: handle it
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(el.dataset.copyEmail!);
        toast.textContent = "Email copied to clipboard";
      } catch {
        window.location.href = el.href;
        return;
      }
      toast.classList.add("show");
      clearTimeout(timer);
      timer = window.setTimeout(() => toast.classList.remove("show"), 2200);
    });
  }
</script>

<style>
  .footer { margin-top: clamp(64px, 9vw, 120px); padding-bottom: 32px; }
  .eyebrow { display: flex; align-items: center; gap: 12px; }
  .num { font-family: var(--mono); font-size: 13px; color: var(--accent); }
  .dash { width: 32px; height: 2px; background: var(--accent); }
  .side { color: var(--fg-2); }
  h2 {
    margin-top: 14px;
    font-size: clamp(44px, 7.5vw, 104px);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.06em;
  }
  h2 span { color: var(--accent); }
  .sub { margin-top: 24px; font-size: clamp(16px, 1.5vw, 18px); color: var(--fg-2); max-width: 32em; }

  .actions {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 40px;
  }
  .email {
    display: inline-flex;
    flex-direction: column;
    gap: 6px;
    font-size: clamp(17px, 1.9vw, 24px);
    font-weight: 700;
    letter-spacing: -0.03em;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 14px 20px;
    transition: background 0.2s ease;
    overflow-wrap: anywhere;
  }
  .email:hover { background: var(--fg); }
  .email .hint { color: inherit; opacity: 0.7; letter-spacing: 0.1em; }
  .socials { display: flex; flex-wrap: wrap; gap: 20px; font-weight: 600; }

  .base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: clamp(56px, 8vw, 96px);
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 60;
    transform: translate(-50%, 12px);
    background: var(--fg);
    color: var(--accent-ink);
    padding: 10px 16px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }
</style>
