---
import Section from "./Section.astro";
import { introHtml, facts } from "../data/profile";
---

<Section id="about" num="01" title="About" label="the short version">
  <p class="intro" data-reveal set:html={introHtml} />

  <ul class="facts" data-reveal>
    {facts.map((f) => (
      <li>
        <p class="value">{f.value}<span class="unit">{f.unit}</span></p>
        <p class="label">{f.label}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .intro {
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.38;
    letter-spacing: -0.015em;
    color: var(--fg-2);
    max-width: 38em;
  }
  .intro :global(strong) { color: var(--fg); font-weight: 600; }
  .intro :global(mark) {
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    padding: 0 0.15em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(40px, 6vw, 72px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .facts li { padding: 20px 16px 20px 0; }
  .facts li + li { border-left: 1px solid var(--line); padding-left: 16px; }
  .value {
    font-size: clamp(30px, 3.6vw, 46px);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .unit {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--accent);
    margin-left: 6px;
  }
  .facts .label { margin-top: 10px; }

  @media (max-width: 760px) {
    .facts li { padding-right: 10px; }
    .facts li + li { padding-left: 10px; }
    .unit { display: block; margin: 6px 0 0; }
  }
</style>
