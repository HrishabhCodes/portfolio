---
import { Image } from "astro:assets";
import portraitImg from "../assets/portrait.jpg";
import { profile } from "../data/profile";

const meta = [
  { k: "Now", v: profile.now.company, href: profile.now.url },
  { k: "Focus", v: profile.focus },
  { k: "Based", v: `${profile.location.city}, ${profile.location.country}` },
];
---

<section id="top" class="hero wrap" aria-label="Introduction">
  <div class="grid">
    <div class="title">
      <h1>
        <span class="sr-only">{profile.name}, </span>
        <span class="role"><span class="w w1">AI</span> <span class="w w2">Engineer<span class="dot">.</span></span></span>
      </h1>
      <p class="line">{profile.heroLine}</p>
    </div>
    <div class="photo">
      <Image
        src={portraitImg}
        alt={`Portrait of ${profile.name}, AI Engineer in ${profile.location.city}`}
        widths={[320, 560, 800]}
        sizes="(max-width: 760px) 100vw, 26vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <div class="bottom">
    <dl class="meta">
      {meta.map((m) => (
        <div>
          <dt class="label">{m.k}</dt>
          <dd>{m.href ? <a class="link-u" href={m.href} target="_blank" rel="noopener">{m.v}</a> : m.v}</dd>
        </div>
      ))}
    </dl>
    <a class="scroll label" href="#about">Scroll <span aria-hidden="true">↓</span></a>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(32px, 5vh, 56px) 28px;
  }
  .grid {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr minmax(180px, 26%);
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
  }
  .role {
    font-size: clamp(56px, 10.5vw, 148px);
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: -0.055em;
  }
  .w { display: block; }
  .dot { color: var(--accent); }
  .line {
    margin-top: clamp(20px, 3vw, 32px);
    max-width: 30em;
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.4;
    color: var(--fg-2);
  }

  .photo { position: relative; margin-right: 12px; }
  .photo::before {
    content: "";
    position: absolute;
    inset: 12px -12px -12px 12px;
    background: var(--accent);
  }
  .photo :global(img) {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    background: #000;
  }

  .bottom {
    display: flex;
    align-items: flex-end;
    gap: 24px;
    margin-top: clamp(28px, 4vw, 48px);
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .meta { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  dd { font-size: clamp(14px, 1.3vw, 16px); font-weight: 600; margin-top: 4px; }
  .scroll { color: var(--accent); white-space: nowrap; }
  .scroll span { display: inline-block; }

  @media (prefers-reduced-motion: no-preference) {
    .w, .line, .photo, .bottom { animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    .w1 { animation-delay: 0.12s; }
    .w2 { animation-delay: 0.22s; }
    .line { animation-delay: 0.32s; }
    .photo { animation-delay: 0.4s; }
    .bottom { animation-delay: 0.5s; }
    .scroll span { animation: nudge 1.6s ease-in-out 1.5s infinite; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(0.35em); }
    to { opacity: 1; transform: none; }
  }
  @keyframes nudge {
    0%, 100% { transform: none; }
    50% { transform: translateY(4px); }
  }

  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; align-content: center; }
    .grid { gap: 28px; }
    .photo { width: calc(100% - 10px); margin-right: 10px; }
    .photo::before { inset: 10px -10px -10px 10px; }
    .photo :global(img) { aspect-ratio: 4 / 3; object-position: 50% 22%; }
    .bottom { flex-direction: column; align-items: stretch; }
    .meta { grid-template-columns: 1fr; gap: 10px; }
    .meta > div { display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--line); padding-bottom: 10px; }
    dd { margin-top: 0; text-align: right; }
    .scroll { display: none; }
  }
</style>
