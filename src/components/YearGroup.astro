---
interface Props {
  year: string;
  count: number;
}

const { year, count } = Astro.props;
---

<section class="year" data-year={year} aria-labelledby={`y-${year}`}>
  <header class="head">
    <h2 id={`y-${year}`} class="numeral">{year}</h2>
    <span class="label count" data-year-count>{count} {count === 1 ? "piece" : "pieces"}</span>
  </header>
  <div class="content"><slot /></div>
</section>

<style>
  .year { margin-top: clamp(56px, 8vw, 96px); }
  .head { display: flex; align-items: baseline; gap: 16px; margin-bottom: 8px; }
  .numeral {
    font-size: clamp(56px, 8vw, 112px);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px #4a4a4a;
  }
  .count { color: var(--accent); }
  .content { min-width: 0; }
</style>
